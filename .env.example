# WalletConnect Cloud project ID — https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Per-chain Loans addresses. Only the chains listed in
# NEXT_PUBLIC_SUPPORTED_CHAINS need a value here. The other protocol
# contracts (CollateralManager, LiquidityPool, SwapManager) are discovered
# on-chain at runtime:
#   CollateralManager = Loans.collateralManager()
#   LiquidityPool     = Loans.liquidityPool()
#   SwapManager       = LiquidityPool.swapManager()
NEXT_PUBLIC_LEMON_LOANS_ADDRESS=
NEXT_PUBLIC_CITRON_LOANS_ADDRESS=
NEXT_PUBLIC_BSC_LOANS_ADDRESS=

# Comma-separated list of chain ids to expose in the wallet network list.
# Order matters — the first entry is the default.
# Known ids:
#   1006 = LemonChain mainnet
#   1005 = LemonChain testnet (Citron)
#   56   = BNB Smart Chain mainnet
NEXT_PUBLIC_SUPPORTED_CHAINS=1006

# Hides the loans page when 'true'. Any other value (or unset) leaves loans
# visible. Inlined at build time — changing it requires a rebuild.
NEXT_PUBLIC_HIDE_LOANS_PAGE=false

# ReferralDepositRouter per chain. Setting this turns the chain REFERRAL-ONLY:
# deposits require a valid referral link. Unset/zero => all referral code is
# inert and deposits take the existing non-referral path (this is the kill
# switch).
NEXT_PUBLIC_CITRON_REFERRAL_ROUTER_ADDRESS=0x4aE07bB550DC860eb52eF570776423589AdD0DBe
NEXT_PUBLIC_LEMON_REFERRAL_ROUTER_ADDRESS=
NEXT_PUBLIC_BSC_REFERRAL_ROUTER_ADDRESS=

# NOTE: the commissions contract is NOT configured here. It is per-company and
# arrives in the referral link as ?commissions=0x..., so one build serves every
# partner. See the Referrals section of the README.
